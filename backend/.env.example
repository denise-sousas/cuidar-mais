# Copie este arquivo para ".env" e ajuste os valores.
# NUNCA envie o arquivo .env para o GitHub.

# Servidor
PORT=3000
NODE_ENV=development
FUSO_HORARIO=America/Sao_Paulo

# Banco de dados PostgreSQL (administrado pelo pgAdmin)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=sua_senha_do_postgresql
DB_NAME=cuidar_mais
DB_SSL=false

# Autenticação (use um texto longo e aleatório, mínimo 16 caracteres)
JWT_SECRET=troque-este-segredo-por-um-texto-bem-grande-e-aleatorio
JWT_EXPIRES_IN=8h

# Opcional: origens permitidas (separe por vírgula). Só é necessário se o
# frontend for aberto em outra porta (ex.: Live Server em http://127.0.0.1:5500).
# CORS_ORIGIN=http://127.0.0.1:5500
